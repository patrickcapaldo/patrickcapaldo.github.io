---
layout: layouts/base.njk
---
<div class="page">
  <div class="post-header">
    <a class="post-back" href="/projects/">← Projects</a>
    <h1>{{ title }}</h1>
    <div class="post-meta">
      {% if tags and tags[0] %}<span class="tag">{{ tags[0] }}</span>{% endif %}
      {% if status %}<span>{{ status }}</span>{% endif %}
      {% if date %}<span> · {{ date | readableDate }}</span>{% endif %}
    </div>
  </div>
  <div class="post-content">
    {{ content | safe }}
  </div>
</div>
